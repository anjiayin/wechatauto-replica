# 复制为 .env 后按需修改；生产环境请直接注入环境变量，不要提交 .env
# ---------------------------------------------------------------------------
# 说明：本服务同时认两套变量名（带 LS_ 前缀的优先）：
#   LS_DB_HOST 或 DB_HOST、LS_KEY_ID 或 LICENSE_KEY_ID ...
# 这样既能与部署脚本统一加前缀，也兼容设计文档里的原始名字。
# ---------------------------------------------------------------------------

# --- HTTP 服务 ---
LS_HOST=127.0.0.1
LS_PORT=8800
LS_ENABLE_DOCS=1
LS_TRUST_PROXY=1

# --- 数据库（生产必须覆盖，禁止使用仓库内的开发默认值）---
LS_DB_HOST=127.0.0.1
LS_DB_PORT=3306
LS_DB_USER=change_me
LS_DB_PASSWORD=change_me
LS_DB_NAME=change_me
LS_DB_CHARSET=utf8mb4
LS_DB_POOL_SIZE=10
LS_DB_CONNECT_TIMEOUT=5

# --- 签名密钥（key_id 必须与客户端 app/license.py 的 PUBLIC_KEYS 键一致）---
LS_KEY_ID=dev
LS_PRIVATE_KEY_PATH=../kefu-system/tools/license_keys/dev_private.pem

# --- 授权默认值 ---
LS_DEFAULT_GRACE_DAYS=7
LS_DEFAULT_EDITION=standard
LS_DEFAULT_CODE_DAYS=365
LS_FEATURES_DEFAULT=monitor,reply,ai

# --- 会话与安全 ---
LS_SESSION_TTL_HOURS=12
LS_SESSION_MAX_DAYS=7
LS_COOKIE_NAME=ls_session
LS_COOKIE_SECURE=0
LS_PBKDF2_ITERATIONS=260000
LS_LOGIN_MAX_FAILED=5
LS_LOGIN_LOCK_MINUTES=15
LS_LOGIN_RATE_LIMIT=20/60
LS_ACTIVATE_RATE_LIMIT=10/60
LS_QUERY_RATE_LIMIT=30/60

# --- 首启管理员（不设口令则随机生成 16 位并打印到控制台 + 强制改密）---
LS_BOOTSTRAP_ADMIN_USER=admin
LS_BOOTSTRAP_ADMIN_PASSWORD=
LS_BOOTSTRAP_ADMIN_DISPLAY=系统管理员
